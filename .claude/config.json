{
  "version": "1.0.0",
  "project": "PlaneetPanmaiLineApp",
  "workflowSystem": {
    "defaultMode": "MANUAL",
    "currentMode": "MANUAL",
    "contextIssueTemplate": "/docs/ISSUE-TEMP.md",
    "taskIssueTemplate": "/docs/TASK-ISSUE-TEMP.md",
    "lastContextNumber": 2,
    "lastTaskNumber": 0
  },
  "safetyRules": {
    "neverTargetMainBranch": true,
    "neverMergePRs": true,
    "requireTaskIssue": true,
    "require100PercentValidation": true,
    "alwaysUseFeatureBranches": true
  },
  "validationRequirements": {
    "buildMustPass": true,
    "lintMustPass": true,
    "testsMustPass": true,
    "typeScriptMustCompile": true
  },
  "commands": {
    "fcs": "Context management",
    "plan": "Task planning",
    "impl": "Task implementation",
    "mode": "Execution mode control",
    "pr": "Pull request creation",
    "rrr": "Daily retrospective",
    "help": "System help"
  }
}